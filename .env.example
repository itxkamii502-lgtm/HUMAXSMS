# HUMAX SMS — Production Environment Configuration Template
# Copy this file to .env on your VPS before starting with PM2:
#   cp .env.example .env

# Server HTTP Port & Bind Host
PORT=3000
HOST=0.0.0.0
NODE_ENV=production

# Trust Nginx / Reverse Proxy X-Forwarded-* headers (set 1 for single Nginx proxy)
TRUST_PROXY=1

# Store live JSON database & backups outside /var/www/humax-sms so git pull never overwrites live data
DATA_DIR=/var/lib/humex-sms/data
BACKUP_DIR=/var/lib/humex-sms/backups

# SMS Log Retention Days (90 = 3 months minimum before archive rotation)
SMS_LOG_RETENTION_DAYS=90

# Security Secret (MUST set strong random string on VPS: openssl rand -hex 32)
INBOUND_TOKEN=change_me_to_a_strong_random_inbound_token

# Optional: Initial Owner password on brand-new empty DATA_DIR (remove after first boot or use reset-owner-password.js)
# OWNER_INITIAL_PASSWORD=ChangeMeStrongPass123!

# Optional Production Console Silencing (disabled by default; never blocks login or DevTools)
CLIENT_GUARD_ENABLED=false
GUARD_PROTECT_OWNER=false

# Comma-separated allowed browser origins for CORS / CSRF validation
# Example: https://sms.yourdomain.com,http://YOUR_VPS_IP
ALLOWED_ORIGINS=https://your-domain.example.com

# Optional override for Owner Range Deletion Security PIN (verified server-side only)
RANGE_DELETE_PIN=

